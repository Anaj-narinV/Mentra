# Copy to .env.local for local development.

# Set to "true" to use the in-memory mock API instead of the real backend
# (useful for frontend-only development/demos without the backend running).
# Defaults to "false" — the app talks to the real FastAPI backend below.
VITE_USE_MOCKS=false

# Base URL of the Mentra backend (see /backend).
VITE_API_BASE_URL=http://localhost:8000
