# Copy to .env and fill in for your environment.
#
# This file is loaded automatically on startup (via python-dotenv, see
# app/core/config.py) — no extra flags needed, `uvicorn app.main:app` picks
# it up on its own. Real environment variables set by your shell, Docker, or
# a hosting platform always take precedence over this file, so it's safe to
# keep around in any environment.

# SQLite for local dev (default). For Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/mentra
DATABASE_URL=sqlite:///./mentra.db

# Change this in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=60

# AI provider credentials. AI_PROVIDER=stub keeps the deterministic
# placeholder (no network calls, used by tests / local dev without a key).
# Set AI_PROVIDER=claude or AI_PROVIDER=gemini and provide AI_API_KEY (the
# key for whichever provider you chose) to use a real model — if the key is
# missing or the provider fails to initialize, the app automatically falls
# back to the stub instead of crashing. AI_MODEL is optional for both; if
# left blank each provider applies its own current default.
#
# AI_PROVIDER=claude example:
#   AI_PROVIDER=claude
#   AI_API_KEY=<your Anthropic key>
#   AI_MODEL=claude-sonnet-5
#
# This file defaults to AI_PROVIDER=gemini below; switch AI_PROVIDER to
# claude and use the example values above instead if you'd rather use that.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
